# SEVERANCE Environment Variables Template

SEVERANCE_ENV=development
SEVERANCE_SECRET_KEY=change-this-in-production-to-a-secure-random-token
SEVERANCE_ADMIN_ID=admin-001
SEVERANCE_ADMIN_PASSWORD=InitialAdminPassword123!
SEVERANCE_BOOTSTRAP_CODE=mrpl-sih-2026-bootstrap-key
SEVERANCE_DB_PATH=severance.db

# Agent Backend: 'ollama' (local sovereign, compliance requirement -- no document
# content may leave this machine), 'mock' (canned offline), or 'adk' (Google ADK)
AGENT_BACKEND=ollama
OLLAMA_API_BASE=http://localhost:11434
# Model auto-selection: leave these UNSET to let agents/registry.py pick the best
# installed model per task from config/models.json. Set one only to pin it.
# OLLAMA_MODEL=gemma3:4b
# Second locally-installed model tried, still fully locally, only if the
# primary model returns zero citations. Set to "" to disable.
OLLAMA_FALLBACK_MODEL=qwen3.5:2b-q4_K_M
# OLLAMA_VISION_MODEL=granite3.2-vision:latest
# Model auto-selection: a distinct locally-installed model used ONLY for the
# "code" intent category (see agents/real.py's classify_intent + draft_code,
# and harness/code_runner.py). Set to "" to reuse OLLAMA_MODEL for code too.
# OLLAMA_CODE_MODEL=qwen2.5-coder:3b
# Model used by the multi-step agent loop (harness/agent_loop.py); defaults to
# the registry's best "planning" model.
# OLLAMA_PLANNER_MODEL=

# Sandboxed code execution limits (agents/sandbox.py)
SANDBOX_TIMEOUT_SECONDS=8
SANDBOX_MEMORY_MB=256

# NOTE: there is intentionally no cloud LLM fallback (no Groq, no NVIDIA NIM).
# Document and question content must never leave this machine -- see
# agents/real.py's module docstring.

# Short per-person conversation memory: how many of the last Q&A turns are
# fed back into intent classification/drafting as context (never as a
# citation source). Keep this small -- each extra turn is more prompt text
# the local model re-reads on every call.
CONVERSATION_MEMORY_TURNS=2
SEVERANCE_RETRIEVAL_MODE=semantic
SEVERANCE_ENABLE_OCR=false
# --- Docker (docker-compose.yml) ---
# Host directory holding already-pulled Ollama models, mounted read-only into
# the ollama container. Defaults to %USERPROFILE%\.ollama\models.
# OLLAMA_MODELS_DIR=C:/Users/you/.ollama/models
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Set automatically by docker-compose.yml; leave unset for a host run.
# SANDBOX_SOCKET=/run/sandbox/sandbox.sock

# --- Sovereignty evidence (trust/egress.py) ---
# block: the server process refuses any connection to a non-private address
# (and records the attempt); log: record only; off: disabled.
SEVERANCE_EGRESS_GUARD=block
# Extra CIDRs treated as on-prem, e.g. a GPU server on a non-RFC1918 range.
# SEVERANCE_EGRESS_ALLOW=
# Per-user agent workspace (files the agent reads/writes).
# SEVERANCE_WORKSPACE_DIR=workspace
